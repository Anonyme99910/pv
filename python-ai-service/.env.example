# SOMA PV AI Service Configuration

# Laravel Backend Integration
LARAVEL_WEBHOOK_URL=http://localhost/pv/pv-backend/public/api/webhooks/ai
LARAVEL_API_URL=http://localhost/pv/pv-backend/public/api

# AI Service Port
AI_SERVICE_PORT=8001
AI_SERVICE_HOST=0.0.0.0

# Model Paths (optional - defaults to trained_models/)
FAULT_MODEL_PATH=trained_models/fault_model.pkl
RUL_MODEL_PATH=trained_models/rul_model.pkl
THERMAL_MODEL_PATH=trained_models/Th_G_v9.pt

# MQTT Configuration (for ESP32 bridge)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=solar/farm/#
